# Copy to .env and customise (never commit .env).

SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Production (DEBUG=False): set SECRET_KEY, ALLOWED_HOSTS, and optionally use PostgreSQL:
# USE_POSTGRES=True
# POSTGRES_DB=chess_club
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# CSRF_TRUSTED_ORIGINS=https://your.domain

# Celery / Lichess / Stockfish (optional for game import pipeline)
# CELERY_BROKER_URL=redis://localhost:6379/0
# STOCKFISH_PATH=/usr/games/stockfish
# Periodic Lichess sync for linked profiles (Celery Beat). Set DISABLE_LICHESS_BEAT=1 to disable.
# LICHESS_BEAT_SCHEDULE_SECONDS=3600
# DISABLE_LICHESS_BEAT=0
